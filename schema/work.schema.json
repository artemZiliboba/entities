{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/entities/work.schema.json",
  "title": "Encyclopedia work",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "tradition", "entities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "original_title": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["folktale", "myth", "legend", "epic", "novel", "story", "poem", "play", "other"]
    },
    "tradition": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "author": { "type": "string" },
    "collection": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["artifact", "character", "creature", "location", "substance", "plant", "animal", "spell", "phenomenon"]
        },
        "description": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
